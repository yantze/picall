{
  "name": "@yantze/picall-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types -- --check && tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "pretest": "node test/build.mjs",
    "types": "wrangler types --env-interface WorkerBindings --include-runtime=false --strict-vars=false"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "agents": "0.33.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "miniflare": "5.20261104.0-beta",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
