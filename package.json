{
  "name": "@yantze/picall",
  "version": "0.9.0",
  "description": "Shared research agent for local Node.js and Cloudflare Workers",
  "type": "module",
  "bin": {
    "picall": "bin/picall.js"
  },
  "exports": {
    ".": "./apps/local/src/server.js"
  },
  "files": [
    "bin",
    "apps/local/src",
    "packages/core/*.js",
    "packages/core/*.d.ts",
    "packages/tools/*.js",
    "packages/ui",
    "docs/*.md",
    "README.md",
    "VALIDATION.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "start": "node bin/picall.js",
    "dev": "node --watch bin/picall.js",
    "test": "npm run test:tools && npm run test:local && npm run test:cloudflare",
    "check": "npm run check:local && npm run check --workspace apps/cloudflare",
    "test:local": "node --import ./apps/local/test/isolate.mjs --test apps/local/test/*.test.js",
    "test:cloudflare": "npm test --workspace apps/cloudflare",
    "check:local": "node --check bin/picall.js && node --check apps/local/src/server.js && node --check apps/local/src/durable-runtime.js && node --check packages/ui/app.js",
    "build:cloudflare": "npm run build --workspace apps/cloudflare",
    "dev:cloudflare": "npm run dev --workspace apps/cloudflare",
    "test:tools": "node --test packages/tools/test/*.test.js",
    "test:browser": "npm run pretest --workspace apps/cloudflare && node --import tsx test/browser.mjs",
    "test:package": "node test/package.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yantze/picall.git"
  },
  "bugs": {
    "url": "https://github.com/yantze/picall/issues"
  },
  "keywords": [
    "pi",
    "openai",
    "llm",
    "agent",
    "durable",
    "sqlite",
    "web-search"
  ],
  "workspaces": [
    "apps/cloudflare"
  ],
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
