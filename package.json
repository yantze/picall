{
  "name": "@yantze/picall",
  "version": "0.3.0",
  "description": "A local OpenAI-compatible API powered by the Pi coding agent",
  "type": "module",
  "bin": { "picall": "bin/picall.js" },
  "exports": { ".": "./src/server.js" },
  "files": ["bin", "src", "public", "README.md", "LICENSE", "THIRD_PARTY.md"],
  "scripts": {
    "start": "node bin/picall.js",
    "dev": "node --watch bin/picall.js",
    "test": "node --test test/*.test.js",
    "check": "node --check bin/picall.js && node --check src/server.js && node --check src/pi-rpc.js && node --check public/app.js"
  },
  "engines": { "node": ">=22.19.0" },
  "dependencies": { "@earendil-works/pi-ai": "1.4.0", "@earendil-works/pi-coding-agent": "1.4.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yantze/picall.git" },
  "bugs": { "url": "https://github.com/yantze/picall/issues" },
  "keywords": ["pi", "openai", "llm", "agent", "rpc", "mcp"]
}
